# Codex defaults tuned for maximum autonomy / minimum prompting.
#
# TEMPLATE: `make install` expands the home-directory placeholder below and
# writes the result to ~/.codex/config.toml. Do not copy this file into place
# by hand -- Codex does not expand environment variables in config paths.

# Never ask for approval. Codex runs commands and edits files on its own.
approval_policy = "never"

# Full filesystem + network access: nothing is blocked, so "never" approval
# does not turn into silent sandbox failures.
sandbox_mode = "danger-full-access"

# Belt-and-suspenders: if sandbox_mode is overridden back to workspace-write
# (e.g. `codex --sandbox workspace-write`), keep it as permissive as possible.
[sandbox_workspace_write]
network_access = true
exclude_tmpdir_env_var = false
exclude_slash_tmp = false
writable_roots = [
  "$HOME/workspace",
  "$HOME/.codex",
  "$HOME/.config",
  "$HOME/.cache",
  "$HOME/.npm",
  "$HOME/.cargo",
  "$HOME/go",
  "/tmp",
  "/private/tmp",
]

# Don't prompt to trust these directories on startup.
[projects."$HOME/workspace"]
trust_level = "trusted"

[projects."$HOME/workspace/genai"]
trust_level = "trusted"

[projects."$HOME/workspace/genai/agent-config"]
trust_level = "trusted"

# Let the agent search the web without asking.
[tools]
web_search = true

# Pass the full shell environment through instead of a filtered subset,
# so tools don't fail on missing credentials/PATH and trigger retries.
[shell_environment_policy]
inherit = "all"
ignore_default_excludes = true
exclude = []

# --- Opt-in fallback profiles -------------------------------------------------

# `codex --profile safe`: sandboxed, but still low-friction.
[profiles.safe]
approval_policy = "on-request"
sandbox_mode = "workspace-write"

[profiles.safe.sandbox_workspace_write]
network_access = true

# `codex --profile readonly`: inspection only, no writes, no prompts.
[profiles.readonly]
approval_policy = "never"
sandbox_mode = "read-only"
